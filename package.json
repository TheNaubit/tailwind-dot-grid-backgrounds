{
  "name": "@nauverse/tailwind-dot-grid-backgrounds",
  "description": "A tiny Tailwind CSS v4 plugin to add customizable dot and grid backgrounds fast, in pure CSS",
  "author": {
    "name": "Albert Adler | @IAmAlbertAdler",
    "url": "https://albertadler.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/TheNaubit/tailwind-dot-grid-backgrounds#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheNaubit/tailwind-dot-grid-backgrounds.git"
  },
  "bugs": {
    "url": "https://github.com/TheNaubit/tailwind-dot-grid-backgrounds/issues"
  },
  "keywords": [
    "tailwind",
    "tailwindcss",
    "tailwindcss-v4",
    "tailwindcss-plugin",
    "css",
    "grid-background",
    "dot-background",
    "background-pattern"
  ],
  "version": "1.2.13",
  "type": "module",
  "style": "./index.css",
  "exports": {
    ".": {
      "style": "./index.css",
      "default": "./index.css"
    },
    "./index.css": "./index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "index.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@tailwindcss/node": "4.3.3",
    "@types/node": "26.6.2",
    "husky": "9.1.7",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.14.0 || >=24.10.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.0",
      "onFail": "warn"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
